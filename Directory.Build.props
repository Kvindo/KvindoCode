<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <!-- Disable Roslyn's long-lived shared compiler server (VBCSCompiler). It was surviving idle
         between builds and pinning ~2-3 cores continuously, which starved the desktop. Per-build
         compile is a little slower (cold Roslyn) but leaves no resident CPU hog. -->
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
</Project>
