<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>KvindoCode.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- the tests exercise internal state that has no public setter (e.g. AgentSession.IsChild for a subagent) -->
    <InternalsVisibleTo Include="KvindoCode.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- gitleaks default rules (MIT), regenerated by tools/update-gitleaks-rules.py -->
    <EmbeddedResource Include="Secrets/gitleaks-rules.json" LogicalName="gitleaks-rules.json" />
  </ItemGroup>
  <ItemGroup>
    <!-- Telegram USER (MTProto) sessions: reading a chat's history and sending AS the user, which the Bot API cannot
         do. Opt-in via Settings (default stays "bot"), and the bot path is unaffected. Licence: MIT. -->
    <PackageReference Include="WTelegramClient" Version="4.4.9" />
  </ItemGroup>
</Project>
