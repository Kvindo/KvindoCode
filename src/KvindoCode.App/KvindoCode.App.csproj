<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>KvindoCode.App</RootNamespace>
    <AssemblyName>kvindocode</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <!-- Repo metadata, for anyone who lands on the package or the project file while searching:
         https://github.com/Kvindo/KvindoCode -->
    <Description>Desktop AI coding agent: Avalonia/.NET app with git-worktree isolation per session, plan review, subagents, a real XTerm grid and an encrypted secret vault that masks credentials before they reach a model.</Description>
    <PackageTags>ai coding agent;ai-agent;coding-assistant;desktop;avalonia;dotnet;csharp;llm;agent;terminal;xterm;git-worktree;secret-scanning;openai-compatible</PackageTags>
    <RepositoryUrl>https://github.com/Kvindo/KvindoCode</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- A REAL terminal: XTerm.NET emulation + Porta.Pty, instead of hand-rendering tmux captures -->
    <PackageReference Include="Iciclecreek.Avalonia.Terminal" Version="4.1.0" />
    <!-- The code editor: AvalonEdit's Avalonia 12 port, plus TextMate for real syntax highlighting -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KvindoCode.Core\KvindoCode.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\tools\update_scores.py" Link="tools\update_scores.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same as Core: the test project asserts on counters and internal seams that exist only so behaviour can be
         measured (dispatcher posts, masker builds, vault writes). Without this they are unreachable and a test for
         exactly the regression it exists to pin would have to go through reflection. -->
    <InternalsVisibleTo Include="KvindoCode.Tests" />
  </ItemGroup>
</Project>
